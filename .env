# =============================================================================
# Image versions (pinned). Renovate/Dependabot
# =============================================================================

# PostgreSQL — https://www.postgresql.org/docs/release
POSTGRES_VERSION=17.10-alpine

# Keycloak — https://github.com/keycloak/keycloak/releases
KC_VERSION=26.6.2

# Prometheus — https://github.com/prometheus/prometheus/releases
PROMETHEUS_VERSION=v3.11.3

# Grafana — https://github.com/grafana/grafana/releases
GF_VERSION=13.0.1-security-01

# =============================================================================
# Keycloak
# =============================================================================
KC_HOSTNAME=http://localhost
KC_PORT=8080

KC_REALM_NAME=grafana
KC_LOG_LEVEL=INFO

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=keycloak

# =============================================================================
# Prometheus
# =============================================================================
PROMETHEUS_PORT=9090

# =============================================================================
# Grafana
# =============================================================================
GF_HOSTNAME=http://localhost
GF_SERVER_HTTP_PORT=3000
GF_LOG_LEVEL=info

GF_ADMIN_USERNAME=admin
GF_ADMIN_PASSWORD=grafana
